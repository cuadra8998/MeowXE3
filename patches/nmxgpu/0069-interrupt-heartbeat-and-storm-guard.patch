@@ -182,16 +186,71 @@
     void (*handler)(void *);
     void *arg;
     volatile SInt32 delivered;
-    bool initIrq() { delivered = 0; return init(); }
+    /* nmxtrace: interrupts per second, a heartbeat in NVRAM, and a guard against an interrupt storm */
+    uint64_t winStart;
+    uint32_t winCount, lastRate;
+    bool stormed;
+    thread_call_t hb;
+    uint32_t hbTicks;
+    bool initIrq() { delivered = 0; winStart = 0; winCount = lastRate = 0; stormed = false; hb = nullptr; hbTicks = 0; return init(); }
 };
 OSDefineMetaClassAndStructors(NMXIrq, OSObject)
 
+/*
+ * nmxtrace heartbeat (Wildcat Lake: after the first panel modeset the whole Mac froze a few seconds later, at a
+ * different step each start, with nothing saved to the log). Every 2 s for 60 s from the first GPU interrupt it writes
+ * "t=<s> irqs=<total> rate=<last second>" to NVRAM (nullmoth-gpu-hb), so the next start shows how long the Mac lived
+ * and whether the GPU's interrupt rate ran away.
+ */
+static void irq_heartbeat(thread_call_param_t p0, thread_call_param_t)
+{
+    NMXIrq *irq = (NMXIrq *)p0;
+    char note[96];
+    irq->hbTicks++;
+    snprintf(note, sizeof(note), "t=%u irqs=%d rate=%u%s", irq->hbTicks * 2, irq->delivered, irq->lastRate,
+             irq->stormed ? " storm-guard-tripped" : "");
+    IOLog("NullMoth GPU: heartbeat %s\n", note);
+    nmx_xnu_nvram_note("nullmoth-gpu-hb", note);
+    if (irq->hbTicks < 30) {
+        uint64_t d;
+        clock_interval_to_deadline(2000, kMillisecondScale, &d);
+        thread_call_enter_delayed(irq->hb, d);
+    }
+}
+
 static void irq_action(OSObject *owner, IOInterruptEventSource *src, int count)
 {
     NMXIrq *irq = OSDynamicCast(NMXIrq, owner);
     if (irq) {
-        if (OSIncrementAtomic(&irq->delivered) == 0)
+        if (OSIncrementAtomic(&irq->delivered) == 0) {
             IOLog("NullMoth GPU: first interrupt delivered\n");
+            if (nmx_trace_get_level() > 0 && (irq->hb = thread_call_allocate(irq_heartbeat, irq)) != nullptr) {
+                uint64_t d;
+                clock_interval_to_deadline(2000, kMillisecondScale, &d);
+                thread_call_enter_delayed(irq->hb, d);
+            }
+        }
+        if (nmx_trace_get_level() > 0) {
+            uint64_t now = mach_absolute_time(), sec;
+            nanoseconds_to_absolutetime(1000000000ull, &sec);
+            if (now - irq->winStart >= sec) {
+                irq->lastRate = irq->winCount;
+                irq->winStart = now;
+                irq->winCount = 0;
+            }
+            /* more than 50000 a second: a source nobody acknowledges. Stop it before it takes the Mac down. */
+            if (++irq->winCount > 50000 && !irq->stormed) {
+                irq->stormed = true;
+                IOLog("NullMoth GPU: interrupt storm (%u in under a second, %d in all): GPU interrupts disabled\n",
+                      irq->winCount, irq->delivered);
+                char note[96];
+                snprintf(note, sizeof(note), "storm: %u/s after %d interrupts, GPU interrupts disabled",
+                         irq->winCount, irq->delivered);
+                nmx_xnu_nvram_note("nullmoth-gpu-hb", note);
+                src->disable();
+                return;
+            }
+        }
         irq->handler(irq->arg);
     }
 }
