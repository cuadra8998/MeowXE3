 OSDefineMetaClassAndStructors(NMXGPU, IOService)
+
+/*
+ * Bring-up diagnostics (nmxtrace), Wildcat Lake: with the firmware's boot framebuffer (IONDRVFramebuffer) still on the
+ * GPU, NMXGPU's framebuffer registering its power driver froze the Mac within milliseconds, and retiring the boot
+ * framebuffer froze it too. These watch, right before the publish, every power change of the GPU's PCI device and of the
+ * boot framebuffer, IOGraphics' events for the boot framebuffer and IOKit messages to both, each with the PCI command
+ * register and D-state, as "attach:" breadcrumbs (NVRAM and the synced flight log).
+ */
+void NMXGPU::logPciState(const char *why)
+{
+    if (nmx_trace_get_level() <= 0 || pci_ == nullptr)
+        return;
+    char b[120];
+    UInt16 cmd = pci_->configRead16(kIOPCIConfigCommand);
+    int dstate = pmCap_ ? (pci_->configRead16(pmCap_ + 4) & 3) : -1;
+    snprintf(b, sizeof(b), "attach: pci %s: command 0x%04x, D-state", why, cmd);
+    nmx_trace(b, dstate);
+}
+
+IOReturn NMXGPU::powerStateWillChangeTo(IOPMPowerFlags caps, unsigned long state, IOService *dev)
+{
+    char b[120];
+    snprintf(b, sizeof(b), "attach: pm %s (%s) will change to state", dev ? dev->getName() : "?",
+             dev ? dev->getMetaClass()->getClassName() : "?");
+    nmx_trace(b, (long)state);
+    logPciState("pm will");
+    return kIOPMAckImplied;
+}
+
+IOReturn NMXGPU::powerStateDidChangeTo(IOPMPowerFlags caps, unsigned long state, IOService *dev)
+{
+    char b[120];
+    snprintf(b, sizeof(b), "attach: pm %s (%s) did change to state", dev ? dev->getName() : "?",
+             dev ? dev->getMetaClass()->getClassName() : "?");
+    nmx_trace(b, (long)state);
+    logPciState("pm did");
+    return kIOPMAckImplied;
+}
+
+IOReturn NMXGPU::fbNotify(OSObject *obj, void *, IOFramebuffer *fb, IOIndex event, void *)
+{
+    char b[120];
+    snprintf(b, sizeof(b), "attach: fb event from %s (%s)", fb ? fb->getName() : "?",
+             fb ? fb->getMetaClass()->getClassName() : "?");
+    nmx_trace(b, (long)event);
+    NMXGPU *me = OSDynamicCast(NMXGPU, obj);
+    if (me)
+        me->logPciState("fb event");
+    return kIOReturnSuccess;
+}
 
+IOReturn NMXGPU::ioMessage(void *target, void *, UInt32 type, IOService *provider, void *, vm_size_t)
+{
+    char b[120];
+    snprintf(b, sizeof(b), "attach: message to %s (%s) 0x%08x", provider ? provider->getName() : "?",
+             provider ? provider->getMetaClass()->getClassName() : "?", type);
+    nmx_trace(b, (long)type);
+    return kIOReturnSuccess;
+}
+
+void NMXGPU::watchBootFramebuffer()
+{
+    if (nmx_trace_get_level() <= 0 || pci_ == nullptr)
+        return;
+    pci_->findPCICapability(kIOPCIPowerManagementCapability, &pmCap_);
+    pci_->registerInterestedDriver(this);
+    pci_->registerInterest(gIOGeneralInterest, &NMXGPU::ioMessage, this, nullptr);
+    int n = 0;
+    IORegistryIterator *it = IORegistryIterator::iterateOver(pci_, gIOServicePlane, kIORegistryIterateRecursively);
+    if (it != nullptr) {
+        for (IORegistryEntry *e; (e = it->getNextObject()) != nullptr; ) {
+            IOFramebuffer *f = OSDynamicCast(IOFramebuffer, e);
+            if (f == nullptr || f->metaCast("IONDRVFramebuffer") == nullptr)
+                continue;
+            f->registerInterestedDriver(this);
+            f->addFramebufferNotification(&NMXGPU::fbNotify, this, nullptr);
+            f->registerInterest(gIOGeneralInterest, &NMXGPU::ioMessage, this, nullptr);
+            n++;
+        }
+        it->release();
+    }
+    nmx_trace("attach: watching the boot framebuffer(s), PCI PM capability at", pmCap_);
+    nmx_trace("attach: boot framebuffers watched", n);
+    logPciState("before the publish");
+}
+
 static IOLock *g_lock;
 static bool g_started;
 static int g_devices;
@@ -343,6 +438,7 @@
     pci_->setProperty("nmxgpu-claimed", kOSBooleanTrue);
     pci_->registerService();
     /* light the outputs and hand them to macOS; without it the device still renders, with no screen of its own */
+    watchBootFramebuffer();
     nmx_trace("attach: publishing the framebuffer", 0);
     fb_ = nmx_fb_publish(this, dev_);
     nmx_trace("attach: framebuffer published", fb_ != nullptr);
diff --git a/gpu-port/xkpi/xnu/nmx_flight.cpp b/gpu-port/xkpi/xnu/nmx_flight.cpp
--- a/gpu-port/xkpi/xnu/nmx_flight.cpp
+++ b/gpu-port/xkpi/xnu/nmx_flight.cpp
@@ -38,6 +38,7 @@
 static vfs_context_t gCtx;
 static off_t gOff;
 static char *gChunkBuf;
+static IOLock *gFileLock;     /* one writer at a time: the thread, or nmx_flight_sync on the caller's */
 
 static bool flight_on()
 {
@@ -297,11 +298,37 @@
         gOff += (off_t)(n - (size_t)uio_resid(uio));
     uio_free(uio);
 }
+
+/* moves what the ring holds to the file and syncs it; gFileLock held */
+static void flight_drain_locked(void);
 
 static void flight_writer(void *, wait_result_t)
 {
     for (;;) {
         IOSleep(40);
+        IOLockLock(gFileLock);
+        flight_drain_locked();
+        IOLockUnlock(gFileLock);
+    }
+}
+
+/*
+ * Called after each NMXGPU step's breadcrumb (bsdcompat/src/nmx_trace.c): the log reaches the disk before the step
+ * runs, so a freeze within milliseconds of it (Wildcat Lake, after the framebuffer's power registration) still leaves
+ * everything up to that step. Thread context only.
+ */
+extern "C" void nmx_flight_sync(void)
+{
+    if (!gStarted || gVp == nullptr || gFileLock == nullptr)
+        return;
+    IOLockLock(gFileLock);
+    flight_drain_locked();
+    IOLockUnlock(gFileLock);
+}
+
+static void flight_drain_locked(void)
+{
+    for (int pass = 0; pass < 32; pass++) {
         boolean_t st = ring_lock();
         uint64_t from = gTail, to = gHead, dropped = gDropped;
         if (to - from > kChunk)
@@ -319,11 +346,11 @@
             if (l > 0)
                 flight_write(note, (size_t)l);
         }
-        if (n) {
-            flight_write(gChunkBuf, n);
-            VNOP_FSYNC(gVp, MNT_WAIT, gCtx);
-        }
+        if (n == 0)
+            break;
+        flight_write(gChunkBuf, n);
     }
+    VNOP_FSYNC(gVp, MNT_WAIT, gCtx);
 }
 
 /* called by the attach once the root file system is up; the ring holds everything printed since the kext loaded */
@@ -333,8 +360,9 @@
         return;
     gStarted = true;
     gChunkBuf = (char *)IOMalloc(kChunk);
+    gFileLock = IOLockAlloc();
     gCtx = vfs_context_create(nullptr);
-    if (gChunkBuf == nullptr || gCtx == nullptr) {
+    if (gChunkBuf == nullptr || gCtx == nullptr || gFileLock == nullptr) {
         IOLog("NullMoth flight recorder: out of memory\n");
         return;
     }
