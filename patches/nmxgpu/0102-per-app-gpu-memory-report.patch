+
+/*
+ * Set by xe's module init (override/xe/nmx_xe_module.c): xe is linked as its own unit with its symbols local, so the
+ * bridge reaches its TT heap query through this pointer, as xe reaches nmx_fb_want_stolen the other way.
+ */
+uint64_t (*nmx_xe_tt_usage_hook)(struct drm_device *dev, uint64_t *size);
+
+int nmx_gpu_clients(void *devp, struct nmx_gpu_client *out, int max, uint64_t *tt_used, uint64_t *tt_size)
+{
+    struct nmx_fb *fb = fb_of(devp);
+    struct drm_file *file;
+    int n = 0;
+    *tt_used = 0;
+    *tt_size = 0;
+    if (fb == NULL || fb->client.dev == NULL)
+        return -1;
+    struct drm_device *dev = fb->client.dev;
+    mutex_lock(&dev->filelist_mutex);
+    list_for_each_entry(file, &dev->filelist, lhead) {
+        if (n >= max)
+            break;
+        struct nmx_gpu_client *c = &out[n++];
+        struct drm_gem_object *obj;
+        int id;
+        memset(c, 0, sizeof(*c));
+        c->pid = (int)file->pid;
+        spin_lock(&file->table_lock);
+        idr_for_each_entry(&file->object_idr, obj, id) {
+            c->objects++;
+            c->bytes += obj->size;
+            if (obj->handle_count > 1 || obj->dma_buf != NULL || obj->import_attach != NULL)
+                c->shared_bytes += obj->size;
+        }
+        spin_unlock(&file->table_lock);
+    }
+    mutex_unlock(&dev->filelist_mutex);
+    if (nmx_xe_tt_usage_hook != NULL)
+        *tt_used = nmx_xe_tt_usage_hook(dev, tt_size);
+    return n;
 }
 
