+/*
+ * MeowXE3: the system-memory heap xe gives userspace (TTM's TT manager: what ANV reports as its heap and measures its
+ * budget against) - bytes in use and its size. 0 for a device another driver owns.
+ */
+extern uint64_t (*nmx_xe_tt_usage_hook)(struct drm_device *dev, uint64_t *size);   /* override/src/nmx_fb_bridge.c */
+static uint64_t nmx_xe_tt_usage(struct drm_device *dev, uint64_t *size)
+{
+    *size = 0;
+    if (dev == NULL || dev->driver == NULL || dev->driver->name == NULL || strcmp(dev->driver->name, "xe") != 0)
+        return 0;
+    struct ttm_resource_manager *man = ttm_manager_type(&to_xe_device(dev)->ttm, XE_PL_TT);
+    if (man == NULL)
+        return 0;
+    *size = (uint64_t)man->size << PAGE_SHIFT;
+    return ttm_resource_manager_usage(man);
+}
