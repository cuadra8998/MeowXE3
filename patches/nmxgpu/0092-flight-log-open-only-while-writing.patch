Subject: [PATCH 0092] flight recorder: open the log file only while writing (shutdown waited on it)

Wildcat Lake tests 26-39: every test start stalled at shutdown. Test 38's 5 s "alive" lines kept reaching the file
for minutes after the shutdown began, with no driver shutdown (no systemWillShutdown breadcrumb), and test 39's
shutdown log showed every process gone but launchd and two DriverKit drivers within 5 s: the kernel was waiting to
unmount the Data volume, held by the flight recorder's vnode, open from the start on. The file is now created and
preallocated at start, then closed, and each drain opens it, writes, syncs and closes it; a drain that cannot open it
(the volume going away) leaves the lines in the ring.

diff --git a/gpu-port/xkpi/xnu/nmx_flight.cpp b/gpu-port/xkpi/xnu/nmx_flight.cpp
index 2f20032..575e475 100644
--- a/gpu-port/xkpi/xnu/nmx_flight.cpp
+++ b/gpu-port/xkpi/xnu/nmx_flight.cpp
@@ -35,7 +35,8 @@ static volatile UInt32 gLock;
 static int gState = -1;                         /* -1 not decided, 0 off, 1 on */
 static bool gLineStart = true;
 static bool gStarted;
-static vnode_t gVp;
+static vnode_t gVp;             /* open only while a drain writes (flight_drain_locked) */
+static bool gFileReady;         /* the file was created and preallocated */
 static vfs_context_t gCtx;
 static off_t gOff;
 static char *gChunkBuf;
@@ -329,7 +330,7 @@ static void flight_writer(void *, wait_result_t)
  */
 extern "C" void nmx_flight_sync(void)
 {
-    if (!gStarted || gVp == nullptr || gFileLock == nullptr)
+    if (!gStarted || !gFileReady || gFileLock == nullptr)
         return;
     IOLockLock(gFileLock);
     flight_drain_locked();
@@ -338,6 +339,22 @@ extern "C" void nmx_flight_sync(void)
 
 static void flight_drain_locked(void)
 {
+    /*
+     * The file is open only while this writes. Kept open for the whole start, its vnode reference held the Data
+     * volume, so shutdown waited forever to unmount it: the Mac ran on (the 5 s "alive" lines kept reaching the file)
+     * but never reached the drivers' shutdown (Wildcat Lake tests 26-39, every start with the flight recorder).
+     */
+    if (!gFileReady)
+        return;
+    boolean_t st0 = ring_lock();
+    bool empty = gTail == gHead && gDropped == 0;
+    ring_unlock(st0);
+    if (empty)
+        return;
+    if (vnode_open(kFlightPath, FWRITE | O_NOFOLLOW, 0644, 0, &gVp, gCtx) != 0) {
+        gVp = nullptr;
+        return;     /* e.g. the volume is being unmounted: the ring keeps the lines */
+    }
     for (int pass = 0; pass < 32; pass++) {
         boolean_t st = ring_lock();
         uint64_t from = gTail, to = gHead, dropped = gDropped;
@@ -361,6 +378,8 @@ static void flight_drain_locked(void)
         flight_write(gChunkBuf, n);
     }
     VNOP_FSYNC(gVp, MNT_WAIT, gCtx);
+    vnode_close(gVp, FWRITE, gCtx);
+    gVp = nullptr;
 }
 
 /* called by the attach once the root file system is up; the ring holds everything printed since the kext loaded */
@@ -399,6 +418,9 @@ extern "C" void nmx_flight_start(void)
         flight_write(gChunkBuf, kChunk);
     VNOP_FSYNC(gVp, MNT_WAIT, gCtx);
     gOff = 0;
+    vnode_close(gVp, FWRITE, gCtx);     /* reopened per drain: an open vnode held the volume at shutdown */
+    gVp = nullptr;
+    gFileReady = true;
     thread_t t;
     if (kernel_thread_start(flight_writer, nullptr, &t) != KERN_SUCCESS) {
         IOLog("NullMoth flight recorder: no writer thread\n");
