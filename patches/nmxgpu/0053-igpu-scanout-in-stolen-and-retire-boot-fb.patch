@@ -223,6 +223,41 @@ edit("xe_pci.c", [
     ("	{ 3000, &media_xe2 },\n",
      "	{ 3000, &media_xe2 },\n	{ 3002, &media_xe2 },\n", 1),
 ])
+# NullMoth on an integrated GPU (Wildcat Lake): the display bridge needs its scan-out buffer to be one physical run,
+# which VRAM is on a discrete GPU but system RAM is not. While the bridge creates it (nmx_fb_want_stolen set by
+# override/src/nmx_fb_bridge.c), a dumb buffer on an IGP goes into stolen memory, GGTT-mapped (so contiguous), as
+# Linux's own fbdev does (display/intel_fbdev_fb.c); Xe2+/Xe3 reach stolen directly through BAR2. Falls back to the
+# usual placement if stolen is full.
+edit("xe_bo.c", [(
+    "\tbo = xe_bo_create_user(xe, NULL, NULL, args->size,\n"
+    "\t\t\t       DRM_XE_GEM_CPU_CACHING_WC,\n"
+    "\t\t\t       XE_BO_FLAG_VRAM_IF_DGFX(xe_device_get_root_tile(xe)) |\n"
+    "\t\t\t       XE_BO_FLAG_SCANOUT |\n"
+    "\t\t\t       XE_BO_FLAG_NEEDS_CPU_ACCESS);\n",
+    "\tbo = NULL;\n"
+    "\tif (nmx_fb_want_stolen && !IS_DGFX(xe) && !xe_ttm_stolen_cpu_access_needs_ggtt(xe)) {\n"
+    "\t\tbo = xe_bo_create_user(xe, NULL, NULL, args->size,\n"
+    "\t\t\t\t       DRM_XE_GEM_CPU_CACHING_WC,\n"
+    "\t\t\t\t       XE_BO_FLAG_STOLEN | XE_BO_FLAG_GGTT |\n"
+    "\t\t\t\t       XE_BO_FLAG_SCANOUT |\n"
+    "\t\t\t\t       XE_BO_FLAG_NEEDS_CPU_ACCESS);\n"
+    "\t\tif (IS_ERR(bo)) {\n"
+    "\t\t\tdrm_info(&xe->drm, \"NullMoth: scan-out buffer in stolen memory failed (%ld)\\n\", PTR_ERR(bo));\n"
+    "\t\t\tbo = NULL;\n"
+    "\t\t} else {\n"
+    "\t\t\tdrm_info(&xe->drm, \"NullMoth: scan-out buffer in stolen memory\\n\");\n"
+    "\t\t}\n"
+    "\t}\n"
+    "\tif (bo == NULL)\n"
+    "\t\tbo = xe_bo_create_user(xe, NULL, NULL, args->size,\n"
+    "\t\t\t\t       DRM_XE_GEM_CPU_CACHING_WC,\n"
+    "\t\t\t\t       XE_BO_FLAG_VRAM_IF_DGFX(xe_device_get_root_tile(xe)) |\n"
+    "\t\t\t\t       XE_BO_FLAG_SCANOUT |\n"
+    "\t\t\t\t       XE_BO_FLAG_NEEDS_CPU_ACCESS);\n", 1),
+    ("int xe_bo_dumb_create(struct drm_file *file_priv,\n",
+     "extern int nmx_fb_want_stolen;\t/* override/src/nmx_fb_bridge.c */\n\nint xe_bo_dumb_create(struct drm_file *file_priv,\n", 1),
+])
+
 print("xe fork applied")
 
