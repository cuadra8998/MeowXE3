 OSDefineMetaClassAndStructors(NMXGPUFB, IOFramebuffer)
 
+/*
+ * The firmware's boot display on the same GPU: on a hackintosh with no graphics kext macOS drives it with
+ * IONDRVFramebuffer, drawing into the GOP buffer. Once this driver has relit the outputs with its own buffer that
+ * framebuffer shows nothing, and WindowServer would keep it as a phantom display drawing into memory the GPU driver
+ * has freed (an integrated GPU's stolen memory). Retire it the way a removed display goes away. Boot argument
+ * -nmxkeepndrv keeps it.
+ */
+static void retire_boot_framebuffer(IOService *gpu, IOService *mine)
+{
+    int dummy = 0;
+    if (PE_parse_boot_argn("-nmxkeepndrv", &dummy, sizeof(dummy)))
+        return;
+    IOService *pci = gpu->getProvider();
+    if (pci == nullptr)
+        return;
+    OSArray *victims = OSArray::withCapacity(2);
+    IORegistryIterator *it = IORegistryIterator::iterateOver(pci, gIOServicePlane, kIORegistryIterateRecursively);
+    if (it == nullptr || victims == nullptr) {
+        OSSafeReleaseNULL(it);
+        OSSafeReleaseNULL(victims);
+        return;
+    }
+    for (IORegistryEntry *e; (e = it->getNextObject()) != nullptr; ) {
+        IOFramebuffer *f = OSDynamicCast(IOFramebuffer, e);
+        if (f != nullptr && f != mine && strstr(f->getMetaClass()->getClassName(), "NDRV") != nullptr)
+            victims->setObject(f);
+    }
+    it->release();
+    for (unsigned i = 0; i < victims->getCount(); i++) {
+        IOService *f = (IOService *)victims->getObject(i);
+        FBLOG("retiring the boot framebuffer %s", f->getMetaClass()->getClassName());
+        f->terminate();
+    }
+    victims->release();
+}
+
 /* lights the device's outputs and publishes them under 'gpu'; nullptr when there is nothing to show (reason logged) */
 IOService *nmx_fb_publish(IOService *gpu, void *dev)
 {
@@ -236,6 +274,7 @@ IOService *nmx_fb_publish(IOService *gpu, void *dev)
         return nullptr;
     }
     fb->registerService();
+    retire_boot_framebuffer(gpu, fb);
     return fb;
 }
 
