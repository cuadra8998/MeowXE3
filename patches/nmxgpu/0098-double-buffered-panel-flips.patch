+/* NMXAccel's double-buffered frames: the buffer on the outputs, the one to copy the next frame into, and the flip */
+int nmx_fb_front(void *dev, uint64_t *kva);
+int nmx_fb_back(void *dev, uint64_t *kva, uint32_t *pitch);
