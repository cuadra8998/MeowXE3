index 1c675fb..6b2bd80 100644
--- a/gpu-port/xkpi/bsdcompat/include/nmxkpi_prelude.h
+++ b/gpu-port/xkpi/bsdcompat/include/nmxkpi_prelude.h
@@ -17,6 +17,15 @@
  */
 #define scnprintf nmx_xnu_scnprintf
 #define vscnprintf nmx_xnu_vscnprintf
+/*
+ * The macOS 26 SDK's kernel headers reach <uuid/uuid.h>, whose uuid_copy(uuid_t, const uuid_t) collides with
+ * LinuxKPI's static inline uuid_copy(linux_uuid_t *, ...). Apple's is taken under another name, here and once: its
+ * include guard keeps any later #include of it from declaring the name again.
+ */
+#define uuid_copy nmx_xnu_uuid_copy
+#if __has_include(<uuid/uuid.h>)
+#include <uuid/uuid.h>
+#endif
 #include <stdint.h>
 #include <stdbool.h>
 #include <stddef.h>
@@ -51,6 +60,7 @@
 #include <sys/kauth.h>
 #undef scnprintf
 #undef vscnprintf
+#undef uuid_copy
 /* mach/error.h names error subsystems err_vm, err_kern...; i915 uses err_vm as a goto label */
 #undef err_vm
 #undef err_kern
