+/*
+ * After a device file opened (linux_compat.c): if it is a DRM client of a device the bridge drives, record the opening
+ * process. drm-kmod's FreeBSD branch stores task_pid(current), which in this port is the thread's id: the per-app GPU
+ * memory report could not name anyone.
+ */
+void nmx_drm_file_opened(void *filp, int pid);
+void nmx_drm_file_opened(void *filp, int pid)
+{
+    for (int i = 0; i < MAX_FB; i++) {
+        struct nmx_fb *fb = fbs[i].fb;
+        struct drm_file *file;
+        if (fb == NULL || fb->client.dev == NULL)
+            continue;
+        mutex_lock(&fb->client.dev->filelist_mutex);
+        list_for_each_entry(file, &fb->client.dev->filelist, lhead)
+            if ((void *)file->filp == filp) {
+                file->pid = pid;
+                break;
+            }
+        mutex_unlock(&fb->client.dev->filelist_mutex);
+    }
+}
