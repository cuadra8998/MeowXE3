Subject: [PATCH 0087] retire: stop the boot framebuffer's AppleUpstreamUserClientDriver clients first

Wildcat Lake: terminating the boot framebuffer panicked in AppleUpstreamUserClientDriver::fbNotificationOccurred
(NULL) in tests 29, 30 and 32 and not in 28 and 31, whatever the wait before it (0086). Terminate its
AppleUpstreamUserClientDriver clients synchronously first, so their stop removes their IOGraphics notification
before IOFramebuffer::terminate notifies the group; they would go with the framebuffer anyway.

diff --git a/gpu-port/xkpi/xnu/nmx_fb.cpp b/gpu-port/xkpi/xnu/nmx_fb.cpp
index b66937c..d2d1396 100644
--- a/gpu-port/xkpi/xnu/nmx_fb.cpp
+++ b/gpu-port/xkpi/xnu/nmx_fb.cpp
@@ -357,6 +357,25 @@ static void retire_boot_framebuffer(IOService *gpu, IOService *mine, bool early
             IOSleep(100);
         }
         nmx_trace("publish: retire: waited for WindowServer on it (100 ms steps, 300 = gave up)", (long)waited);
+        /*
+         * Stop the boot framebuffer's AppleUpstreamUserClientDriver clients first, synchronously: their stop removes
+         * their IOGraphics notification, and terminate's group notification to them panicked on NULL in
+         * fbNotificationOccurred in tests 29, 30 and 32 (not 28 and 31) whatever the timing. They go with the
+         * framebuffer's termination anyway.
+         */
+        OSArray *clients = OSArray::withCapacity(2);
+        OSIterator *cl = clients ? f->getClientIterator() : nullptr;
+        if (cl != nullptr) {
+            for (OSObject *c; (c = cl->getNextObject()) != nullptr; )
+                if (c->metaCast("AppleUpstreamUserClientDriver") != nullptr)
+                    clients->setObject(c);
+            cl->release();
+        }
+        nmx_trace("publish: retire: AppleUpstreamUserClient clients to stop", clients ? (long)clients->getCount() : -1L);
+        for (unsigned k = 0; clients != nullptr && k < clients->getCount(); k++)
+            nmx_trace("publish: retire: client terminated (ret)",
+                      (long)((IOService *)clients->getObject(k))->terminate(kIOServiceSynchronous));
+        OSSafeReleaseNULL(clients);
         nmx_trace("publish: retire: terminate requested", (long)i);
         f->terminate();
         nmx_trace("publish: retire: terminate returned", (long)i);
