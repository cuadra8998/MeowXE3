@@ -148,8 +256,53 @@ public:
         nmx_trace("publish: cb open", 0);
         IOReturn r = IOFramebuffer::open();
         nmx_trace("publish: cb open done (ret)", (long)r);
+        /* 0x200: only an opened framebuffer may be registered with the accelerator's display machine (registering
+           before open panicked in IOFramebuffer::getAttributeExt); NMXAccel registers this head here, on WindowServer's
+           thread, before open returns, so WindowServer finds its display pipe (ericek111's NMXVGAFB::open) */
+        if ((fFlags & kFbAccelHead) && r == kIOReturnSuccess && opened && OSCompareAndSwap(0, 1, &fOpenedOnce)) {
+            setProperty("NMXVGAFBOpen", kOSBooleanTrue);
+            if (IOService *a = fAccel) {
+                const OSSymbol *fn = OSSymbol::withCStringNoCopy("nmxHeadOpened");
+                IOReturn ar = fn ? a->callPlatformFunction(fn, true, this, nullptr, nullptr, nullptr) : kIOReturnNoMemory;
+                OSSafeReleaseNULL(fn);
+                FBLOG("opened; the accelerator registered this head (0x%x)", ar);
+                nmx_trace("publish: accel: nmxHeadOpened (ret)", (long)ar);
+            } else {
+                FBLOG("opened before an accelerator armed this head: it registers the head when it does");
+                nmx_trace("publish: accel: opened before the accelerator armed it", 0);
+            }
+        }
         return r;
     }
+    IOReturn callPlatformFunction(const OSSymbol *fn, bool wait, void *p1, void *p2, void *p3, void *p4) override {
+        if (!(fFlags & kFbAccelHead) || fn == nullptr)
+            return IOFramebuffer::callPlatformFunction(fn, wait, p1, p2, p3, p4);
+        if (fn->isEqualTo("nmxDisplayReady")) {             /* NMXAccel armed this head (its phase 1) */
+            IOService *a = OSDynamicCast(IOService, (OSObject *)p1);
+            if (!a) return kIOReturnBadArgument;
+            if (!fAccel) { a->retain(); if (!OSCompareAndSwapPtr(nullptr, a, (void *volatile *)&fAccel)) a->release(); }
+            nmx_trace("publish: accel: nmxDisplayReady", 0);
+            nmx_gpu_accel_armed(getProvider());
+            return kIOReturnSuccess;
+        }
+        if (fn->isEqualTo("nvAllocVram") || fn->isEqualTo("nvFreeVram")) {
+            NVRMVramRequest *r = (NVRMVramRequest *)p1;
+            if (!r || r->version != NVRM_VRAM_ABI_VERSION) return kIOReturnBadArgument;
+            return fn->isEqualTo("nvAllocVram") ? nmxVramAlloc(r) : nmxVramFree(r);
+        }
+        if (fn->isEqualTo("nvScanoutInfo")) {
+            /* the real physical address of the live scan-out (stolen memory): with phys 0 CoreDisplay failed
+               MPAccessSurfaceForDisplayDevice and WindowServer stayed on the CPU (ericek111) */
+            NVRMVramRequest *r = (NVRMVramRequest *)p1;
+            if (!r || r->version != NVRM_VRAM_ABI_VERSION) return kIOReturnBadArgument;
+            r->kva = (void *)(uintptr_t)fInfo.kva;
+            r->phys = fInfo.phys;
+            r->actualSize = (unsigned long long)fInfo.pitch * fInfo.height;
+            r->width = fInfo.width; r->height = fInfo.height; r->pitch = fInfo.pitch;
+            return kIOReturnSuccess;
+        }
+        return IOFramebuffer::callPlatformFunction(fn, wait, p1, p2, p3, p4);
+    }
     bool isConsoleDevice() override { nmx_trace("publish: cb isConsoleDevice", fFlags); return !(fFlags & kFbNoConsole); }
     IODeviceMemory *getApertureRange(IOPixelAperture aperture) override {
         nmx_trace("publish: cb getApertureRange", (long)aperture);
