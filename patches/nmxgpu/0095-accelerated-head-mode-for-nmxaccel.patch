 #define FBLOG(fmt, ...) IOLog("NullMoth display: " fmt "\n", ##__VA_ARGS__)
 
+/*
+ * nullmoth-fbflags 0x200 (bring-up): the panel framebuffer is NMXAccel's head 0, so WindowServer composites on the GPU
+ * (ericek111's NMXVGAFB contract, vibe-nullmoth-xe3-qemu part 4, on a real Intel display engine): class NMXIntelGPUFB
+ * (CoreDisplay's IOPresentment wants the vendor in the class name; NMXAccel watches for it), head-0 properties, the
+ * VRAM grants of nvrm_vram_abi.h (contiguous system memory for WindowServer's display surfaces), the live scan-out in
+ * stolen memory, NMXVGAFBOpen + nmxHeadOpened when WindowServer opens it, and NMXGPU's display hold released by the
+ * accelerator's nmxDisplayReady (xnu/nmx_kext.cpp) instead of at the publish.
+ */
+#define NVRM_VRAM_ABI_VERSION 2u
+struct NVRMVramRequest {
+    unsigned int version, flags;
+    unsigned long long size, actualSize, phys;
+    void *kva, *handle;
+    unsigned long long mappedTotal;
+    unsigned int width, height, pitch;
+    unsigned long long allocationCookie;
+};
+extern "C++" void nmx_gpu_accel_armed(IOService *gpu);   /* xnu/nmx_kext.cpp: releases the display hold */
+
+static constexpr unsigned kVramSlots = 4;                   /* WindowServer's three display surfaces and a spare */
+static constexpr unsigned long long kVramBudget = 512ull << 20;
+static IOBufferMemoryDescriptor *gVramSlot[kVramSlots];
+static volatile UInt32 gVramSlotBusy = 0;
+static unsigned long long gVramSlotBytes = 0;
+static IOLock *gVramLock = nullptr;
+static volatile SInt64 gVramUsed = 0, gVramCookie = 0;
+
+/* reserved at start, while memory is unfragmented (ericek111's 0046: a late 20 MB contiguous run was not found) */
+static void nmxVramReserve(unsigned long long slotBytes)
+{
+    if (!gVramLock && !(gVramLock = IOLockAlloc())) return;
+    IOLockLock(gVramLock);
+    if (!gVramSlotBytes) {
+        unsigned n = 0;
+        for (; n < kVramSlots; n++)
+            if (!(gVramSlot[n] = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+                      kIODirectionInOut | kIOMemoryPhysicallyContiguous, slotBytes, 0x000000FFFFFFF000ull))) break;
+        if (n) gVramSlotBytes = slotBytes;
+        for (unsigned i = n; i < kVramSlots; i++) gVramSlotBusy |= 1u << i;
+        FBLOG("VRAM: %u of %u slots of %llu bytes reserved", n, kVramSlots, slotBytes);
+    }
+    IOLockUnlock(gVramLock);
+}
+
+static IOReturn nmxVramAlloc(NVRMVramRequest *r)
+{
+    const unsigned long long want = (r->size + PAGE_SIZE - 1) & ~(unsigned long long)(PAGE_SIZE - 1);
+    if (!want) return kIOReturnBadArgument;
+    if ((unsigned long long)OSAddAtomic64((SInt64)want, &gVramUsed) + want > kVramBudget) {
+        OSAddAtomic64(-(SInt64)want, &gVramUsed);
+        FBLOG("nvAllocVram(%llu): refused, budget spent", want);
+        return kIOReturnNoSpace;
+    }
+    IOBufferMemoryDescriptor *b = nullptr;
+    if (gVramLock && want <= gVramSlotBytes) {
+        IOLockLock(gVramLock);
+        for (unsigned i = 0; i < kVramSlots && !b; i++)
+            if (!(gVramSlotBusy & (1u << i))) { gVramSlotBusy |= 1u << i; b = gVramSlot[i]; b->retain(); }
+        IOLockUnlock(gVramLock);
+    }
+    if (!b) b = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+        kIODirectionInOut | kIOMemoryPhysicallyContiguous, want, 0x000000FFFFFFF000ull);
+    if (!b) {
+        OSAddAtomic64(-(SInt64)want, &gVramUsed);
+        FBLOG("nvAllocVram(%llu): no contiguous system memory", want);
+        return kIOReturnNoMemory;
+    }
+    bzero(b->getBytesNoCopy(), want);
+    r->handle = b; r->kva = b->getBytesNoCopy();
+    r->phys = b->getPhysicalSegment(0, nullptr, kIOMemoryMapperNone);
+    r->actualSize = want;
+    r->mappedTotal = (unsigned long long)gVramUsed;
+    r->allocationCookie = (unsigned long long)OSAddAtomic64(1, &gVramCookie) + 1;
+    nmx_trace("publish: accel: nvAllocVram (KB)", (long)(want >> 10));
+    return kIOReturnSuccess;
+}
+
+static IOReturn nmxVramFree(NVRMVramRequest *r)
+{
+    IOBufferMemoryDescriptor *b = OSDynamicCast(IOBufferMemoryDescriptor, (OSObject *)r->handle);
+    if (!b) return kIOReturnBadArgument;
+    OSAddAtomic64(-(SInt64)(r->actualSize ? r->actualSize : b->getLength()), &gVramUsed);
+    if (gVramLock) {
+        IOLockLock(gVramLock);
+        for (unsigned i = 0; i < kVramSlots; i++) if (gVramSlot[i] == b) gVramSlotBusy &= ~(1u << i);
+        IOLockUnlock(gVramLock);
+    }
+    b->release();
+    r->handle = nullptr; r->kva = nullptr; r->phys = 0; r->actualSize = 0; r->allocationCookie = 0;
+    return kIOReturnSuccess;
+}
+
