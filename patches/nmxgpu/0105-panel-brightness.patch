+extern int (*nmx_xe_backlight_hook)(struct drm_device *dev, int set, int *cur);     /* override/src/nmx_fb_bridge.c */
+
+/*
+ * MeowXE3: the eDP panel's backlight for macOS's brightness keys and slider (NMXIntelGPUFB's backlight handler). The
+ * level goes through intel_backlight_set_acpi, the display driver's entry for firmware (ACPI) brightness requests: a
+ * 0..100 level scaled into the panel's PWM range, above its minimum, applied while the backlight is on.
+ */
+static int nmx_xe_backlight(struct drm_device *dev, int set, int *cur)
+{
+    struct drm_connector_list_iter it;
+    struct drm_connector *c;
+    int err = ENODEV;
+    if (dev == NULL || dev->driver == NULL || dev->driver->name == NULL || strcmp(dev->driver->name, "xe") != 0)
+        return ENODEV;
+    drm_modeset_lock(&dev->mode_config.connection_mutex, NULL);
+    drm_connector_list_iter_begin(dev, &it);
+    drm_for_each_connector_iter(c, &it) {
+        if (c->connector_type != DRM_MODE_CONNECTOR_eDP)
+            continue;
+        struct intel_panel *p = &to_intel_connector(c)->panel;
+        if (!p->backlight.present || p->backlight.max == 0)
+            continue;
+        if (set >= 0 && c->state != NULL)
+            intel_backlight_set_acpi(c->state, (u32)(set > 100 ? 100 : set), 100);
+        if (cur != NULL) {
+            u32 lo = p->backlight.min, hi = p->backlight.max, lv = p->backlight.level;
+            *cur = hi > lo && lv >= lo ? (int)((u64)(lv - lo) * 100 / (hi - lo)) : 100;
+        }
+        err = 0;
+        break;
+    }
+    drm_connector_list_iter_end(&it);
+    drm_modeset_unlock(&dev->mode_config.connection_mutex);
+    return err;
+}
