--- a/gpu-port/audio/build.sh
+++ b/gpu-port/audio/build.sh
@@ -9,7 +9,7 @@
 cd "$A"
 mkdir -p gen obj
 for m in "$F/pcm/channel_if.m" "$F/pcm/mixer_if.m" "$F/pci/hda/hdac_if.m"; do
-    /opt/homebrew/bin/python3 mkif.py "$m" "gen/$(basename "$m" .m).h"
+    /usr/bin/python3 mkif.py "$m" "gen/$(basename "$m" .m).h"
 done
 rm -f obj/*.o
 for s in "$F/pci/hda/hdac.c" "$F/pci/hda/hdacc.c" "$F/pci/hda/hdaa.c" "$F/pci/hda/hdaa_patches.c" nmx_snd_compat.c nmx_pcm.c nmx_audio_stubs.c; do
@@ -24,7 +24,15 @@
   -DAPPLE -DNeXT -std=c++17 -fno-rtti -fno-exceptions -fno-builtin -fno-common -O2 -g0 -Wall -Wno-unused-parameter \
   -Wno-deprecated-declarations -Wno-inconsistent-missing-override -c nmx_audio_kext.cpp -o obj/nmx_audio_kext.o \
   > log-kext.txt 2>&1 || { grep -A3 error: log-kext.txt | head -30; exit 1; }
-XNU=$(ls "$X"/xnuobj/*.o | grep -vE "/(nmx_kext|nmx_fb|nmx_npu_kext)\.o$")
+# MeowXE3: MeowXE3.kext links the same layer, and IOKit allows one class per name system-wide: the second kext to
+# load failed ("Couldn't alloc class"). The DRM user client (IOAccelNMXDRMClient) is the GPU's alone and stays out; the
+# interrupt glue is compiled again here with its class renamed (NMXIrq -> NMXAudioIrq).
+xcrun clang++ -arch x86_64 -mmacosx-version-min=15.0 -ffile-prefix-map=$NULLMOTH_BUILD_ROOT/build/gpu-src=/src -mkernel -fapple-kext \
+  -nostdinc -isysroot "$SDK" -I"$KF" -I"$X"/bsdcompat/include/nmxxnu -DKERNEL -DKERNEL_PRIVATE -DDRIVER_PRIVATE \
+  -DAPPLE -DNeXT -DNMXIrq=NMXAudioIrq -std=c++17 -fno-rtti -fno-exceptions -fno-builtin -fno-common -O2 -g0 -Wall \
+  -Wno-unused-parameter -Wno-deprecated-declarations -Wno-inconsistent-missing-override \
+  -c "$X"/xnu/nmx_pci.cpp -o obj/nmx_pci_audio.o > log-pci.txt 2>&1 || { grep -A3 error: log-pci.txt | head -30; exit 1; }
+XNU=$(ls "$X"/xnuobj/*.o | grep -vE "/(nmx_kext|nmx_fb|nmx_npu_kext|nmx_drmuc|nmx_pci)\.o$")
 K="$OUT/NMXAudio.kext/Contents"
 rm -rf "$OUT/NMXAudio.kext"; mkdir -p "$K/MacOS"
 xcrun clang -arch x86_64 -mmacosx-version-min=15.0 -fapple-kext -nostdlib -Xlinker -kext \
