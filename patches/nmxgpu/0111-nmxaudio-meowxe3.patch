+/*
+ * MeowXE3: the shared layer's tracer (bsdcompat nmx_trace.c, Wildcat Lake bring-up patches) sets drm-kmod's debug mask
+ * and leaves NVRAM breadcrumbs through NMXGPU's kext glue, neither of which this kext links. Audio has no DRM and keeps
+ * no breadcrumbs: these stand in so the kext links.
+ */
+unsigned long __drm_debug;
+void nmx_xnu_trace_breadcrumb(const char *step) { (void)step; }
