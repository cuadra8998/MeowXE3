Subject: [PATCH 0075] Interrupt diagnostics, and %pV expanded in the flight log

Wildcat Lake flight log of test start 19: NMXGPU's modeset lit the panel (link training passed, pipe A on, backlight
on); 20 ms after drm_client_register no GPU interrupt was delivered again (count stuck at 57), so the next commit's
flip_done waited out its 10 s and the start died after it. Also seen: every drm_info/drm_warn/drm_err printed as
"[drm] 0x...V", because drm_print.c passes them as %pV, which xnu's formatter does not know.

- xnu/nmx_flight.cpp: formats containing %pV are walked conversion by conversion and %pV (struct va_format) is
  expanded recursively, so drm's info/warning/error messages are readable; other formats are unchanged.
- xnu/nmx_pci.cpp: the heartbeat shows handler returns next to deliveries (irqs=N done=M: M < N means a handler that
  never returned) and the GPU's interrupt registers through nmx_irq_state_hook.
- override/xe/nmx_xe_debug.c: nmx_xe_irq_state() reads (without side effects) DG1_MSTR_TILE_INTR, GFX_MSTR_IRQ, xe's
  irq.enabled, pipe A's DE ISR/IMR/IIR/IER, the hot-plug ISR/IMR/IIR/IER, GU misc IIR and the display interrupt
  control; set as the hook when xe registers.
- fork_xe.py: checkpoints in every step of dg1_irq_handler (lock-aware).

Applies on top of 0051-0074.

diff --git a/gpu-port/xkpi/xnu/nmx_flight.cpp b/gpu-port/xkpi/xnu/nmx_flight.cpp
--- a/gpu-port/xkpi/xnu/nmx_flight.cpp
+++ b/gpu-port/xkpi/xnu/nmx_flight.cpp
@@ -98,10 +98,161 @@
     ring_unlock(st);
 }
 
+/*
+ * Linux's %pV (a struct va_format: a nested format and its va_list), which drm_print.c passes to dev_printk/printk for
+ * every drm_info/drm_warn/drm_err. xnu's formatter does not know it and printed the pointer and a 'V', so those
+ * messages were lost. A format containing %pV is walked here conversion by conversion (each formatted by vsnprintf's
+ * engine with its own argument), and %pV is expanded recursively; any other format goes to vsnprintf unchanged.
+ */
+struct nmx_va_format {
+    const char *fmt;
+    va_list *va;
+};
+
+/* the kernel SDK declares neither strstr nor strchr */
+static bool has_pV(const char *f)
+{
+    for (; *f; f++)
+        if (f[0] == '%' && f[1] == 'p' && f[2] == 'V')
+            return true;
+    return false;
+}
+
+static bool in_set(char c, const char *set)
+{
+    for (; *set; set++)
+        if (*set == c)
+            return true;
+    return false;
+}
+
+static int nmx_vformat(char *out, size_t cap, const char *fmt, va_list ap);
+
+static size_t fmt_put(char *out, size_t cap, size_t pos, const char *s, size_t n)
+{
+    for (size_t i = 0; i < n && pos + 1 < cap; i++)
+        out[pos++] = s[i];
+    if (cap)
+        out[pos < cap ? pos : cap - 1] = '\0';
+    return pos;
+}
+
+static size_t fmt_one(char *out, size_t cap, size_t pos, const char *spec, ...)
+{
+    char tmp[256];
+    va_list a;
+    va_start(a, spec);
+    int n = vsnprintf(tmp, sizeof(tmp), spec, a);
+    va_end(a);
+    if (n < 0)
+        return pos;
+    return fmt_put(out, cap, pos, tmp, (size_t)n < sizeof(tmp) ? (size_t)n : sizeof(tmp) - 1);
+}
+
+static int nmx_vformat(char *out, size_t cap, const char *fmt, va_list ap)
+{
+    if (!has_pV(fmt))
+        return vsnprintf(out, cap, fmt, ap);
+    size_t pos = 0;
+    if (cap)
+        out[0] = '\0';
+    for (const char *p = fmt; *p; ) {
+        if (*p != '%') {
+            pos = fmt_put(out, cap, pos, p, 1);
+            p++;
+            continue;
+        }
+        if (p[1] == '%') {
+            pos = fmt_put(out, cap, pos, "%", 1);
+            p += 2;
+            continue;
+        }
+        /* rebuild the conversion with '*' resolved: %[flags][width][.prec][length]conv */
+        char spec[48];
+        size_t sl = 0;
+        spec[sl++] = *p++;
+        while (*p && in_set(*p, "-+ #0'") && sl < 40)
+            spec[sl++] = *p++;
+        if (*p == '*') {
+            sl += (size_t)snprintf(spec + sl, sizeof(spec) - sl, "%d", va_arg(ap, int));
+            p++;
+        } else
+            while (*p >= '0' && *p <= '9' && sl < 40)
+                spec[sl++] = *p++;
+        if (*p == '.') {
+            spec[sl++] = *p++;
+            if (*p == '*') {
+                sl += (size_t)snprintf(spec + sl, sizeof(spec) - sl, "%d", va_arg(ap, int));
+                p++;
+            } else
+                while (*p >= '0' && *p <= '9' && sl < 40)
+                    spec[sl++] = *p++;
+        }
+        int lng = 0;    /* 0 int, 1 long, 2 long long */
+        while (*p && in_set(*p, "hljztqL") && sl < 44) {
+            if (*p == 'l' || *p == 'j' || *p == 'z' || *p == 't')
+                lng = lng ? 2 : 1;
+            if (*p == 'q' || *p == 'L')
+                lng = 2;
+            spec[sl++] = *p++;
+        }
+        char conv = *p;
+        if (conv == '\0')
+            break;
+        p++;
+        spec[sl++] = conv;
+        spec[sl] = '\0';
+        switch (conv) {
+        case 'p':
+            if (*p == 'V') {
+                p++;
+                struct nmx_va_format *vaf = va_arg(ap, struct nmx_va_format *);
+                if (vaf && vaf->fmt && vaf->va) {
+                    char nested[512];
+                    va_list c;
+                    va_copy(c, *vaf->va);
+                    int n = nmx_vformat(nested, sizeof(nested), vaf->fmt, c);
+                    va_end(c);
+                    if (n > 0)
+                        pos = fmt_put(out, cap, pos, nested, (size_t)n < sizeof(nested) ? (size_t)n : sizeof(nested) - 1);
+                }
+            } else
+                pos = fmt_one(out, cap, pos, spec, va_arg(ap, void *));
+            break;
+        case 's':
+            pos = fmt_one(out, cap, pos, spec, va_arg(ap, const char *));
+            break;
+        case 'c':
+            pos = fmt_one(out, cap, pos, spec, va_arg(ap, int));
+            break;
+        case 'd': case 'i':
+            if (lng == 2) pos = fmt_one(out, cap, pos, spec, va_arg(ap, long long));
+            else if (lng == 1) pos = fmt_one(out, cap, pos, spec, va_arg(ap, long));
+            else pos = fmt_one(out, cap, pos, spec, va_arg(ap, int));
+            break;
+        case 'u': case 'o': case 'x': case 'X':
+            if (lng == 2) pos = fmt_one(out, cap, pos, spec, va_arg(ap, unsigned long long));
+            else if (lng == 1) pos = fmt_one(out, cap, pos, spec, va_arg(ap, unsigned long));
+            else pos = fmt_one(out, cap, pos, spec, va_arg(ap, unsigned int));
+            break;
+        case 'b': {     /* FreeBSD/xnu %b: a value and a bit-name string */
+            int v = va_arg(ap, int);
+            const char *bits = va_arg(ap, const char *);
+            pos = fmt_one(out, cap, pos, spec, v, bits);
+            break;
+        }
+        default:        /* unknown: show it as written */
+            pos = fmt_put(out, cap, pos, spec, sl);
+            break;
+        }
+    }
+    return (int)pos;
+}
+
