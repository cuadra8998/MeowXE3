+/*
+ * For the nmxtrace heartbeat (xnu/nmx_pci.cpp): the interrupt registers, read without side effects, so a start whose
+ * GPU interrupts stop shows whether the master unit is left disabled or a source is pending/masked. Display: pipe A
+ * (ISR/IMR/IIR/IER at 0x44400), hot-plug (0x44470), GU misc IIR (0x444f8), display interrupt control (0x44200).
+ */
+extern int (*nmx_irq_state_hook)(char *buf, unsigned len);
+
+static int nmx_xe_irq_state(char *buf, unsigned len)
+{
+	struct xe_device *xe = nmx_xe;
+	struct xe_mmio *m;
+
+	if (xe == NULL)
+		return 0;
+	m = xe_root_tile_mmio(xe);
+#define R(off) xe_mmio_read32(m, XE_REG(off))
+	return snprintf(buf, len, "tile 0x%08x gfx 0x%08x on %d | pipeA isr 0x%x imr 0x%x iir 0x%x ier 0x%x | "
+			"hpd isr 0x%x imr 0x%x iir 0x%x ier 0x%x | gu_misc iir 0x%x | disp_ctl 0x%08x",
+			R(0x190008), R(0x190010), atomic_read(&xe->irq.enabled),
+			R(0x44400), R(0x44404), R(0x44408), R(0x4440c),
+			R(0x44470), R(0x44474), R(0x44478), R(0x4447c), R(0x444f8), R(0x44200));
+#undef R
+}
+
 void nmx_xe_debug_register(struct xe_device *xe)
 {
 	nmx_xe = xe;
+	nmx_irq_state_hook = nmx_xe_irq_state;
 	nmx_xnu_set_dump_hook(nmx_xe_dump);
 }
