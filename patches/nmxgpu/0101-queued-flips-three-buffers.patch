 /*
- * Puts the back buffer on the outputs (the plane's new address latches at vertical blank) and swaps the roles. The
- * commit waits for flip_done, so the old front is free when this returns. A flip that takes longer than kFlipMaxNs
- * (the 10 s flip_done timeout of a commit whose vblank never comes, seen on this display engine) turns flipping off
- * for this start: NMXAccel then copies onto the visible buffer again (nmx_fb_back fails).
+ * Flips queued frames onto the outputs, one blocking commit each (the plane's new address latches at vertical blank).
+ * A commit that fails or takes longer than kFlipMaxNs (the 10 s flip_done timeout of a commit whose vblank never
+ * comes, seen on this display engine) turns flipping off for this start: the outputs keep the buffer they had and
+ * NMXAccel copies onto it from then on (nmx_fb_back fails).
  */
 #define kFlipMaxNs (100ull * 1000 * 1000)
+static void flip_worker(struct work_struct *work)
+{
+    struct nmx_fb *fb = container_of(work, struct nmx_fb, flip_work);
+    for (;;) {
+        mutex_lock(&fb->flip_lock);
+        int q = fb->flips_ok && fb->dpms_on ? slot_in(fb, SLOT_QUEUED) : -1;
+        if (q < 0) {
+            mutex_unlock(&fb->flip_lock);
+            return;
+        }
+        fb->slot_state[q] = SLOT_PENDING;
+        point_outputs_at(fb, fb->slot[q]);
+        mutex_unlock(&fb->flip_lock);
+
+        uint64_t t0 = ktime_get_ns();
+        int err = -drm_client_modeset_commit(&fb->client);
+        uint64_t dt = ktime_get_ns() - t0;
+
+        mutex_lock(&fb->flip_lock);
+        if (err || dt > kFlipMaxNs) {
+            fb->slot_state[q] = SLOT_FREE;
+            for (int i = 0; i < fb->nslots; i++)
+                if (fb->slot_state[i] != SLOT_FRONT)
+                    fb->slot_state[i] = SLOT_FREE;
+            fb->flips_ok = 0;
+            point_outputs_at(fb, fb->slot[fb->front]);
+            if (err)
+                printf("NullMoth display: a flip failed (%d): frames are copied onto the visible buffer from now on\n", err);
+            else
+                printf("NullMoth display: a flip took %llu ms: flips off, frames are copied onto the visible buffer again\n",
+                       (unsigned long long)(dt / 1000000));
+        } else {
+            fb->slot_state[fb->front] = SLOT_FREE;
+            fb->slot_state[q] = SLOT_FRONT;
+            fb->front = q;
+            fb->buffer = fb->slot[q];
+            fb->map = fb->slot_map[q];
+        }
+        mutex_unlock(&fb->flip_lock);
+        wake_up_all(&fb->flip_wait);
+    }
+}
