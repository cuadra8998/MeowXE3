From cf3fc301e1ccb98d4c44b749156d85d1c345a72d Mon Sep 17 00:00:00 2001
From: nmx <nmx@local>
Date: Sun, 15 Nov 2026 21:37:55 -0800
Subject: [PATCH] NMXAGDC: the head-0 framebuffer is NMXGPU's NMXIntelGPUFB
 (fallback lookups)

---
 kexts/NMXAGDC/gen.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/kexts/NMXAGDC/gen.py b/kexts/NMXAGDC/gen.py
index 5a31b69..eac1424 100644
--- a/kexts/NMXAGDC/gen.py
+++ b/kexts/NMXAGDC/gen.py
@@ -129,5 +129,8 @@ static void nvdaAgdcRemoveSysctl(void)
     sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_gamma); sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_gamma_answers);
     sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_711_types);
 """)
+# NMXGPU (Wildcat Lake): the head-0 framebuffer is NMXGPU's own panel framebuffer, NMXIntelGPUFB, under the GPU it
+# drives; NMXAccel hands it to nmxAgdcUp, and the fallback lookups look for it rather than the VM display
+s = s.replace('serviceMatching("NMXVGAFB")', 'serviceMatching("NMXIntelGPUFB")')
 open(os.path.join(here, "nmx-agdc.cpp"), "w").write("// GENERATED by gen.py from ../NVRMAGDC/nvrm-agdc.cpp. Do not edit.\n" + s)
 print("nmx-agdc.cpp written")
-- 
