From 51b81b85167ebba2816068e42c7a164272691582 Mon Sep 17 00:00:00 2001
From: MeowXE3 <meowxe3@localhost>
Date: Tue, 17 Nov 2026 14:20:23 -0800
Subject: [PATCH] WIP plugin: surface textures advertise ShaderWrite when a
 storage twin can carry the writes (Photo Booth: Core Image draws, preview
 still black; panics came sooner) - NOT released

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugin/NVMTLDevice.m | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/plugin/NVMTLDevice.m b/plugin/NVMTLDevice.m
index 4512352..b890f2e 100644
--- a/plugin/NVMTLDevice.m
+++ b/plugin/NVMTLDevice.m
@@ -895,9 +895,15 @@ static NSUInteger nvmtl_surface_usage(NSUInteger usage, BOOL fbo, BOOL storage)
     if (usage == MTLTextureUsageUnknown) return usage;
     static int ws = -1;
     if (ws < 0) { const char *me = getprogname(); ws = me && !strcmp(me, "WindowServer"); }
+    // MeowXE3: on Intel a pitch-linear BGRA8 surface (Photo Booth's 720x480 preview) is no storage image, so ShaderWrite
+    // was left out and Core Image still refused it. A kernel writes such a texture through its optimal-tiled storage
+    // twin (nvmtl_storage_view_for), which needs ShaderWrite in the usage, so say it whenever the twin can carry the
+    // writes. NVMTL_SURFACE_TWIN_WRITE=0 keeps ShaderWrite for directly storable surfaces only.
+    static int twin = -1;
+    if (twin < 0) { const char *e = getenv("NVMTL_SURFACE_TWIN_WRITE"); twin = !(e && e[0] == '0'); }
     if (!fbo && !ws) {
         usage |= MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
-        if (storage) usage |= MTLTextureUsageShaderWrite;
+        if (storage || twin) usage |= MTLTextureUsageShaderWrite;
     }
     return usage;
 }
