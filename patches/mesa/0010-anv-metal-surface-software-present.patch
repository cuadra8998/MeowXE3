diff --git a/src/intel/vulkan/anv_device.c b/src/intel/vulkan/anv_device.c
index 7f37f9c..8839a36 100644
--- a/src/intel/vulkan/anv_device.c
+++ b/src/intel/vulkan/anv_device.c
@@ -1871,8 +1871,15 @@ VkResult anv_AllocateMemory(
     * easy to catch those as Xe KMD driver will print warnings in dmesg when
     * scanning buffers allocated without proper flag set.
     */
+#ifndef __APPLE__
    if (wsi_info)
       alloc_flags |= ANV_BO_ALLOC_SCANOUT;
+#else
+   /* MeowXE3: on macOS a swapchain buffer is never scanned out by this GPU: the Metal WSI's software path reads it
+    * on the CPU and copies it into a CAMetalLayer drawable. xe refuses CPU-cached (WB) memory for scanout BOs, and the
+    * software path asks for cached memory, so with the flag every swapchain failed (VK_ERROR_OUT_OF_DEVICE_MEMORY). */
+   (void)wsi_info;
+#endif
 
    struct anv_image *image = dedicated_info ?
                              anv_image_from_handle(dedicated_info->image) :
